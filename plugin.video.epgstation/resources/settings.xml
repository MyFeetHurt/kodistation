<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings version="1">
    <section id="plugin.video.epgstation">
        <category id="server" label="30200">
            <group id="1">
                <setting id="server_url" type="string" label="30201">
                    <level>0</level>
                    <default>http://localhost:8888</default>
                    <control type="edit" format="string"><heading>30201</heading></control>
                </setting>
                <setting id="username" type="string" label="30202">
                    <level>0</level>
                    <default/>
                    <constraints><allowempty>true</allowempty></constraints>
                    <control type="edit" format="string"><heading>30202</heading></control>
                </setting>
                <setting id="password" type="string" label="30203">
                    <level>0</level>
                    <default/>
                    <constraints><allowempty>true</allowempty></constraints>
                    <control type="edit" format="string"><heading>30203</heading><hidden>true</hidden></control>
                </setting>
            </group>
        </category>
        <category id="display" label="30210">
            <group id="1">
                <setting id="page_size" type="integer" label="30211">
                    <level>0</level>
                    <default>50</default>
                    <constraints><minimum>10</minimum><step>10</step><maximum>500</maximum></constraints>
                    <control type="slider" format="integer"><popup>false</popup></control>
                </setting>
                <setting id="genre_language" type="integer" label="30212">
                    <level>0</level>
                    <default>0</default>
                    <constraints>
                        <options>
                            <option label="30213">0</option>
                            <option label="30214">1</option>
                        </options>
                    </constraints>
                    <control type="list" format="string"/>
                </setting>
                <setting id="prefer_video" type="integer" label="30215">
                    <level>0</level>
                    <default>0</default>
                    <constraints>
                        <options>
                            <option label="30216">0</option>
                            <option label="30217">1</option>
                        </options>
                    </constraints>
                    <control type="list" format="string"/>
                </setting>
                <setting id="real_duration" type="boolean" label="30218">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
            </group>
        </category>
        <!-- live TV (012) -->
        <category id="live" label="30230">
            <group id="1">
                <setting id="live_mode" type="integer" label="30231" help="30235">
                    <level>0</level>
                    <default>0</default>
                    <constraints>
                        <options>
                            <option label="30232">0</option>
                            <option label="30233">1</option>
                            <option label="30234">2</option>
                        </options>
                    </constraints>
                    <control type="list" format="string"/>
                </setting>
            </group>
        </category>
        <!-- transcoded playback (011) -->
        <category id="stream" label="30280">
            <group id="1">
                <setting id="stream_mode" type="integer" label="30281" help="30283">
                    <level>0</level>
                    <default>0</default>
                    <constraints>
                        <options>
                            <option label="30284">0</option>
                            <option label="30285">1</option>
                            <option label="30282">2</option>
                        </options>
                    </constraints>
                    <control type="list" format="string"/>
                </setting>
            </group>
        </category>
        <!-- record from the guide (014) -->
        <category id="record" label="30240">
            <group id="1">
                <setting id="record_encode" type="integer" label="30241" help="30244">
                    <level>0</level>
                    <default>0</default>
                    <constraints>
                        <options>
                            <option label="30242">0</option>
                            <option label="30243">1</option>
                        </options>
                    </constraints>
                    <control type="list" format="string"/>
                </setting>
            </group>
        </category>
    </section>
</settings>
