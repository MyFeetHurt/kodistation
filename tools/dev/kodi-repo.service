# Kodi add-on repository for KODIstation (backlog 010): static HTTP (with Range) on :8090 serving /srv/kodi-repo.
# The CI release job (the runner's account on this VM, @USER@) publishes into /srv/kodi-repo; Kodi boxes read it.
# Installed by tools/dev/install_kodi_repo_server.sh, which fills in @USER@ and copies tools/dev/kodi_repo_server.py to
# /usr/local/lib/kodi-repo/ (http.server plus Range support: Kodi reads zips over HTTP with Range requests).
[Unit]
Description=KODIstation Kodi repository (static HTTP on :8090)
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
Group=@USER@
ExecStart=/usr/bin/python3 /usr/local/lib/kodi-repo/kodi_repo_server.py --port 8090 --bind 0.0.0.0 --directory /srv/kodi-repo
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/srv/kodi-repo
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
