# Local settings for KODIstation development. Copy to ~/.config/epgstation-kodi/local.env (or point $LOCAL_ENV at
# your copy) and fill in your own machines. The Makefile includes it and the tools read it (tools/local_env.py).
# KEY=value lines only: no spaces, quotes, `$` or `|`; lists are comma-separated. Never commit your copy.

# Kodi box for make deploy / smoke (ssh + JSON-RPC on :8080); empty user = ssh's default
KODI_HOST=kodi.local
KODI_SSH_USER=kodi
# EPGStation the dev tools may write to (tools/dev/*), and the one they must never write to
EPGS_DEV_URL=http://epgstation.local:8888
EPGS_PROD_URL=http://epgstation-main.local:8888
# make screenshot: libvirt host (ssh) and VM domain of the Kodi box
SCREENSHOT_SSH=vmhost.local
SCREENSHOT_VM=kodi-vm

# Public export (maintainers only, tools/export_public.py)
PUBLIC_DIR=~/kodistation-public
PUBLIC_GIT_NAME=yourname
PUBLIC_GIT_EMAIL=12345+yourname@users.noreply.github.com
# Extra literals the public audit must never find (host names, user names, ports, your e-mail)
# PUBLIC_AUDIT_DENY=host1,user1
# One-per-line private deny / allow lists (optional)
PUBLIC_AUDIT_DENY_FILE=
PUBLIC_AUDIT_ALLOW_FILE=
